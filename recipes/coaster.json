{
  "id": "coaster",
  "name": "Coaster",
  "description": "Round, square or hex coaster with rim, text and cork recess.",
  "parts": {
    "base": {
      "label": "Coaster",
      "color": "#0f766e",
      "edges": {
        "top": "edgeTop",
        "topSize": "edgeTopSize",
        "bottom": "edgeBottom",
        "bottomSize": "edgeBottomSize",
        "bottomChamfer": "edgeBottomChamfer"
      }
    },
    "accent": {
      "label": "Text",
      "color": "#fbbf24"
    }
  },
  "params": [
    {
      "key": "shape",
      "type": "select",
      "label": "Shape",
      "default": "round",
      "group": "Shape",
      "options": [
        {
          "value": "round",
          "label": "Round"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "hexagon",
          "label": "Hexagon"
        }
      ]
    },
    {
      "key": "diameter",
      "type": "number",
      "unit": "mm",
      "label": "Size",
      "default": 95,
      "min": 50,
      "max": 200,
      "step": 1,
      "group": "Shape"
    },
    {
      "key": "corner",
      "type": "number",
      "unit": "mm",
      "label": "Corner radius",
      "default": 10,
      "min": 0,
      "max": 50,
      "step": 1,
      "group": "Shape",
      "showIf": "shape == 'square'"
    },
    {
      "key": "thickness",
      "type": "number",
      "unit": "mm",
      "label": "Thickness",
      "default": 4,
      "min": 1.5,
      "max": 12,
      "step": 0.2,
      "group": "Shape"
    },
    {
      "key": "rim",
      "type": "boolean",
      "label": "Raised rim",
      "default": true,
      "group": "Rim"
    },
    {
      "key": "rimWidth",
      "type": "number",
      "unit": "mm",
      "label": "Rim width",
      "default": 3,
      "min": 1,
      "max": 15,
      "step": 0.5,
      "group": "Rim",
      "showIf": "rim"
    },
    {
      "key": "rimHeight",
      "type": "number",
      "unit": "mm",
      "label": "Rim height",
      "default": 1.5,
      "min": 0.4,
      "max": 6,
      "step": 0.1,
      "group": "Rim",
      "showIf": "rim"
    },
    {
      "key": "label",
      "type": "text",
      "label": "Text",
      "default": "Prost!",
      "group": "Text"
    },
    {
      "key": "labelStyle",
      "type": "select",
      "label": "Text style",
      "default": "raised",
      "group": "Text",
      "options": [
        {
          "value": "raised",
          "label": "Raised"
        },
        {
          "value": "flush",
          "label": "Flush inlay"
        },
        {
          "value": "engraved",
          "label": "Engraved"
        }
      ],
      "help": "Raised: filament swap. Flush: multi-material. Engraved: one color."
    },
    {
      "key": "labelSize",
      "type": "number",
      "unit": "mm",
      "label": "Letter height",
      "default": 14,
      "min": 4,
      "max": 60,
      "step": 1,
      "group": "Text"
    },
    {
      "key": "labelDepth",
      "type": "number",
      "unit": "mm",
      "label": "Text height / depth",
      "default": 1,
      "min": 0.2,
      "max": 4,
      "step": 0.1,
      "group": "Text"
    },
    {
      "key": "font",
      "type": "select",
      "label": "Font",
      "default": "bold",
      "options": [
        {
          "value": "regular",
          "label": "Open Sans",
          "group": "Sans"
        },
        {
          "value": "bold",
          "label": "Open Sans Bold",
          "group": "Sans"
        },
        {
          "value": "inter",
          "label": "Inter",
          "group": "Sans"
        },
        {
          "value": "interBold",
          "label": "Inter Bold",
          "group": "Sans"
        },
        {
          "value": "interBlack",
          "label": "Inter Black",
          "group": "Sans"
        },
        {
          "value": "montserrat",
          "label": "Montserrat Bold",
          "group": "Sans"
        },
        {
          "value": "poppins",
          "label": "Poppins Bold",
          "group": "Sans"
        },
        {
          "value": "lato",
          "label": "Lato Black",
          "group": "Sans"
        },
        {
          "value": "workSans",
          "label": "Work Sans Bold",
          "group": "Sans"
        },
        {
          "value": "archivoBlack",
          "label": "Archivo Black",
          "group": "Sans"
        },
        {
          "value": "rounded",
          "label": "Varela Round",
          "group": "Rounded"
        },
        {
          "value": "nunito",
          "label": "Nunito ExtraBold",
          "group": "Rounded"
        },
        {
          "value": "fredoka",
          "label": "Fredoka SemiBold",
          "group": "Rounded"
        },
        {
          "value": "comfortaa",
          "label": "Comfortaa Bold",
          "group": "Rounded"
        },
        {
          "value": "quicksand",
          "label": "Quicksand Bold",
          "group": "Rounded"
        },
        {
          "value": "condensed",
          "label": "Bebas Neue (capitals)",
          "group": "Condensed"
        },
        {
          "value": "oswald",
          "label": "Oswald SemiBold",
          "group": "Condensed"
        },
        {
          "value": "barlowCondensed",
          "label": "Barlow Condensed Bold",
          "group": "Condensed"
        },
        {
          "value": "anton",
          "label": "Anton",
          "group": "Condensed"
        },
        {
          "value": "slab",
          "label": "Roboto Slab Bold",
          "group": "Serif"
        },
        {
          "value": "serif",
          "label": "Noto Serif Bold",
          "group": "Serif"
        },
        {
          "value": "merriweather",
          "label": "Merriweather Black",
          "group": "Serif"
        },
        {
          "value": "playfair",
          "label": "Playfair Display Bold",
          "group": "Serif"
        },
        {
          "value": "lora",
          "label": "Lora Bold",
          "group": "Serif"
        },
        {
          "value": "abrilFatface",
          "label": "Abril Fatface",
          "group": "Serif"
        },
        {
          "value": "stencil",
          "label": "Allerta Stencil",
          "group": "Display"
        },
        {
          "value": "blackOps",
          "label": "Black Ops One (stencil)",
          "group": "Display"
        },
        {
          "value": "bungee",
          "label": "Bungee",
          "group": "Display"
        },
        {
          "value": "righteous",
          "label": "Righteous",
          "group": "Display"
        },
        {
          "value": "orbitron",
          "label": "Orbitron Bold",
          "group": "Display"
        },
        {
          "value": "pixel",
          "label": "Press Start 2P (pixel)",
          "group": "Display"
        },
        {
          "value": "marker",
          "label": "Permanent Marker",
          "group": "Display"
        },
        {
          "value": "script",
          "label": "Pacifico",
          "group": "Script"
        },
        {
          "value": "lobster",
          "label": "Lobster",
          "group": "Script"
        },
        {
          "value": "dancingScript",
          "label": "Dancing Script Bold",
          "group": "Script"
        },
        {
          "value": "kaushan",
          "label": "Kaushan Script",
          "group": "Script"
        },
        {
          "value": "mono",
          "label": "Roboto Mono Bold",
          "group": "Monospace"
        },
        {
          "value": "jetbrainsMono",
          "label": "JetBrains Mono Bold",
          "group": "Monospace"
        },
        {
          "value": "spaceMono",
          "label": "Space Mono Bold",
          "group": "Monospace"
        },
        {
          "value": "custom",
          "label": "Your own font file",
          "group": "Your own"
        }
      ],
      "group": "Text"
    },
    {
      "key": "labelBold",
      "type": "boolean",
      "label": "Bold",
      "default": false,
      "group": "Text",
      "help": "Bold, italic and underline work with every font."
    },
    {
      "key": "labelItalic",
      "type": "boolean",
      "label": "Italic",
      "default": false,
      "group": "Text"
    },
    {
      "key": "labelUnderline",
      "type": "boolean",
      "label": "Underline",
      "default": false,
      "group": "Text"
    },
    {
      "key": "recess",
      "type": "boolean",
      "label": "Recess for cork / felt pad",
      "default": false,
      "group": "Bottom"
    },
    {
      "key": "recessDepth",
      "type": "number",
      "unit": "mm",
      "label": "Recess depth",
      "default": 1,
      "min": 0.4,
      "max": 4,
      "step": 0.1,
      "group": "Bottom",
      "showIf": "recess"
    },
    {
      "key": "recessInset",
      "type": "number",
      "unit": "mm",
      "label": "Recess inset from edge",
      "default": 4,
      "min": 1,
      "max": 20,
      "step": 0.5,
      "group": "Bottom",
      "showIf": "recess"
    },
    {
      "key": "edgeTop",
      "type": "select",
      "label": "Top edges",
      "default": "none",
      "group": "Edges",
      "options": [
        {
          "value": "none",
          "label": "Sharp"
        },
        {
          "value": "chamfer",
          "label": "Chamfer"
        },
        {
          "value": "fillet",
          "label": "Fillet"
        }
      ]
    },
    {
      "key": "edgeTopSize",
      "type": "number",
      "unit": "mm",
      "label": "Top edge size",
      "default": 0.8,
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "group": "Edges",
      "showIf": "edgeTop != 'none'"
    },
    {
      "key": "edgeBottom",
      "type": "select",
      "label": "Bottom edges",
      "default": "none",
      "group": "Edges",
      "help": "Printable fillet: 45° chamfer, then a fillet. Prints without supports.",
      "options": [
        {
          "value": "none",
          "label": "Sharp"
        },
        {
          "value": "chamfer",
          "label": "Chamfer"
        },
        {
          "value": "fillet",
          "label": "Fillet"
        },
        {
          "value": "printable",
          "label": "Printable fillet"
        }
      ]
    },
    {
      "key": "edgeBottomSize",
      "type": "number",
      "unit": "mm",
      "label": "Bottom edge size",
      "default": 1,
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "group": "Edges",
      "help": "Chamfer width or fillet radius.",
      "showIf": "edgeBottom != 'none'"
    },
    {
      "key": "edgeBottomChamfer",
      "type": "number",
      "unit": "mm",
      "label": "45° chamfer height",
      "default": 1,
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "group": "Edges",
      "showIf": "edgeBottom == 'printable'"
    }
  ],
  "derived": {
    "outline": "shape == 'round' ? 'circle' : shape == 'square' ? 'roundedRect' : 'polygon'",
    "flatFactor": "shape == 'hexagon' ? 1 / cos(30) : 1",
    "innerSize": "diameter - 2 * rimWidth * flatFactor",
    "recessSize": "diameter - 2 * recessInset * flatFactor"
  },
  "steps": [
    {
      "add": "shape",
      "part": "base",
      "comment": "plate",
      "shape": "outline",
      "diameter": "diameter",
      "width": "diameter",
      "height": "diameter",
      "radius": "corner",
      "sides": 6,
      "thickness": "thickness"
    },
    {
      "add": "shape",
      "part": "base",
      "when": "rim",
      "comment": "rim block, hollowed out by the next step",
      "shape": "outline",
      "diameter": "diameter",
      "width": "diameter",
      "height": "diameter",
      "radius": "corner",
      "sides": 6,
      "z": "thickness",
      "thickness": "rimHeight"
    },
    {
      "subtract": "shape",
      "when": "rim",
      "shape": "outline",
      "diameter": "innerSize",
      "width": "innerSize",
      "height": "innerSize",
      "radius": "max(corner - rimWidth, 0)",
      "sides": 6,
      "z": "thickness",
      "thickness": "rimHeight + 1"
    },
    {
      "subtract": "shape",
      "when": "recess",
      "comment": "pocket underneath",
      "shape": "outline",
      "diameter": "recessSize",
      "width": "recessSize",
      "height": "recessSize",
      "radius": "max(corner - recessInset, 0)",
      "sides": 6,
      "z": -1,
      "thickness": "recessDepth + 1"
    },
    {
      "add": "text",
      "part": "accent",
      "when": "labelStyle == 'raised'",
      "text": "label",
      "size": "labelSize",
      "font": "font",
      "z": "thickness",
      "thickness": "labelDepth",
      "bold": "labelBold",
      "italic": "labelItalic",
      "underline": "labelUnderline"
    },
    {
      "add": "text",
      "part": "accent",
      "when": "labelStyle == 'flush'",
      "text": "label",
      "size": "labelSize",
      "font": "font",
      "z": "thickness - labelDepth",
      "thickness": "labelDepth",
      "bold": "labelBold",
      "italic": "labelItalic",
      "underline": "labelUnderline"
    },
    {
      "subtract": "text",
      "from": "base",
      "when": "labelStyle == 'engraved'",
      "text": "label",
      "size": "labelSize",
      "font": "font",
      "z": "thickness - labelDepth",
      "thickness": "labelDepth + 1",
      "bold": "labelBold",
      "italic": "labelItalic",
      "underline": "labelUnderline"
    }
  ],
  "notes": [
    {
      "when": "rim && labelStyle == 'raised'",
      "text": "A filament swap would also color the rim top. Turn the rim off or use the multi-material 3MF."
    },
    {
      "when": "recess && recessDepth > thickness - 1",
      "text": "Less than 1 mm left above the recess. Go thicker or shallower."
    },
    {
      "when": "labelStyle != 'raised' && labelDepth >= thickness",
      "text": "Text is as deep as the coaster. Reduce the depth."
    }
  ]
}
