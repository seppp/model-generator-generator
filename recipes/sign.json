{
  "id": "sign",
  "name": "Name sign",
  "description": "Sign with raised text, border and screw holes.",
  "parts": {
    "base": {
      "label": "Plate",
      "color": "#1e3a8a",
      "edges": {
        "top": "edgeTop",
        "topSize": "edgeTopSize",
        "bottom": "edgeBottom",
        "bottomSize": "edgeBottomSize",
        "bottomChamfer": "edgeBottomChamfer"
      }
    },
    "accent": {
      "label": "Text and border",
      "color": "#f8fafc"
    },
    "border": {
      "label": "Border and lines",
      "color": "#fbbf24"
    }
  },
  "params": [
    {
      "key": "text",
      "type": "text",
      "label": "Text",
      "default": "Werkstatt",
      "group": "Text"
    },
    {
      "key": "textSize",
      "type": "number",
      "unit": "mm",
      "label": "Letter height",
      "default": 16,
      "min": 4,
      "max": 100,
      "step": 1,
      "group": "Text"
    },
    {
      "key": "font",
      "type": "select",
      "label": "Font",
      "default": "bold",
      "options": [
        {
          "value": "regular",
          "label": "Open Sans",
          "group": "Sans"
        },
        {
          "value": "bold",
          "label": "Open Sans Bold",
          "group": "Sans"
        },
        {
          "value": "inter",
          "label": "Inter",
          "group": "Sans"
        },
        {
          "value": "interBold",
          "label": "Inter Bold",
          "group": "Sans"
        },
        {
          "value": "interBlack",
          "label": "Inter Black",
          "group": "Sans"
        },
        {
          "value": "montserrat",
          "label": "Montserrat Bold",
          "group": "Sans"
        },
        {
          "value": "poppins",
          "label": "Poppins Bold",
          "group": "Sans"
        },
        {
          "value": "lato",
          "label": "Lato Black",
          "group": "Sans"
        },
        {
          "value": "workSans",
          "label": "Work Sans Bold",
          "group": "Sans"
        },
        {
          "value": "archivoBlack",
          "label": "Archivo Black",
          "group": "Sans"
        },
        {
          "value": "rounded",
          "label": "Varela Round",
          "group": "Rounded"
        },
        {
          "value": "nunito",
          "label": "Nunito ExtraBold",
          "group": "Rounded"
        },
        {
          "value": "fredoka",
          "label": "Fredoka SemiBold",
          "group": "Rounded"
        },
        {
          "value": "comfortaa",
          "label": "Comfortaa Bold",
          "group": "Rounded"
        },
        {
          "value": "quicksand",
          "label": "Quicksand Bold",
          "group": "Rounded"
        },
        {
          "value": "condensed",
          "label": "Bebas Neue (capitals)",
          "group": "Condensed"
        },
        {
          "value": "oswald",
          "label": "Oswald SemiBold",
          "group": "Condensed"
        },
        {
          "value": "barlowCondensed",
          "label": "Barlow Condensed Bold",
          "group": "Condensed"
        },
        {
          "value": "anton",
          "label": "Anton",
          "group": "Condensed"
        },
        {
          "value": "slab",
          "label": "Roboto Slab Bold",
          "group": "Serif"
        },
        {
          "value": "serif",
          "label": "Noto Serif Bold",
          "group": "Serif"
        },
        {
          "value": "merriweather",
          "label": "Merriweather Black",
          "group": "Serif"
        },
        {
          "value": "playfair",
          "label": "Playfair Display Bold",
          "group": "Serif"
        },
        {
          "value": "lora",
          "label": "Lora Bold",
          "group": "Serif"
        },
        {
          "value": "abrilFatface",
          "label": "Abril Fatface",
          "group": "Serif"
        },
        {
          "value": "stencil",
          "label": "Allerta Stencil",
          "group": "Display"
        },
        {
          "value": "blackOps",
          "label": "Black Ops One (stencil)",
          "group": "Display"
        },
        {
          "value": "bungee",
          "label": "Bungee",
          "group": "Display"
        },
        {
          "value": "righteous",
          "label": "Righteous",
          "group": "Display"
        },
        {
          "value": "orbitron",
          "label": "Orbitron Bold",
          "group": "Display"
        },
        {
          "value": "pixel",
          "label": "Press Start 2P (pixel)",
          "group": "Display"
        },
        {
          "value": "marker",
          "label": "Permanent Marker",
          "group": "Display"
        },
        {
          "value": "script",
          "label": "Pacifico",
          "group": "Script"
        },
        {
          "value": "lobster",
          "label": "Lobster",
          "group": "Script"
        },
        {
          "value": "dancingScript",
          "label": "Dancing Script Bold",
          "group": "Script"
        },
        {
          "value": "kaushan",
          "label": "Kaushan Script",
          "group": "Script"
        },
        {
          "value": "mono",
          "label": "Roboto Mono Bold",
          "group": "Monospace"
        },
        {
          "value": "jetbrainsMono",
          "label": "JetBrains Mono Bold",
          "group": "Monospace"
        },
        {
          "value": "spaceMono",
          "label": "Space Mono Bold",
          "group": "Monospace"
        },
        {
          "value": "custom",
          "label": "Your own font file",
          "group": "Your own"
        }
      ],
      "group": "Text"
    },
    {
      "key": "raise",
      "type": "number",
      "unit": "mm",
      "label": "Text and border height",
      "default": 1,
      "min": 0.2,
      "max": 5,
      "step": 0.1,
      "group": "Text"
    },
    {
      "key": "width",
      "type": "number",
      "unit": "mm",
      "label": "Width",
      "default": 140,
      "min": 30,
      "max": 250,
      "step": 1,
      "group": "Plate"
    },
    {
      "key": "height",
      "type": "number",
      "unit": "mm",
      "label": "Height",
      "default": 40,
      "min": 15,
      "max": 200,
      "step": 1,
      "group": "Plate"
    },
    {
      "key": "corner",
      "type": "number",
      "unit": "mm",
      "label": "Corner radius",
      "default": 5,
      "min": 0,
      "max": 40,
      "step": 0.5,
      "group": "Plate"
    },
    {
      "key": "thickness",
      "type": "number",
      "unit": "mm",
      "label": "Thickness",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 0.2,
      "group": "Plate"
    },
    {
      "key": "border",
      "type": "boolean",
      "label": "Border",
      "default": true,
      "group": "Border and lines"
    },
    {
      "key": "borderWidth",
      "type": "number",
      "unit": "mm",
      "label": "Border width",
      "default": 2,
      "min": 0.8,
      "max": 10,
      "step": 0.2,
      "group": "Border and lines",
      "showIf": "border"
    },
    {
      "key": "borderInset",
      "type": "number",
      "unit": "mm",
      "label": "Border inset",
      "default": 3,
      "min": 0,
      "max": 20,
      "step": 0.5,
      "group": "Border and lines",
      "showIf": "border"
    },
    {
      "key": "border2",
      "type": "boolean",
      "label": "Second line inside",
      "default": false,
      "group": "Border and lines",
      "showIf": "border"
    },
    {
      "key": "border2Width",
      "type": "number",
      "unit": "mm",
      "label": "Second line width",
      "default": 1,
      "min": 0.4,
      "max": 10,
      "step": 0.2,
      "group": "Border and lines",
      "showIf": "border && border2"
    },
    {
      "key": "border2Gap",
      "type": "number",
      "unit": "mm",
      "label": "Gap between the lines",
      "default": 1.5,
      "min": 0.4,
      "max": 10,
      "step": 0.1,
      "group": "Border and lines",
      "showIf": "border && border2"
    },
    {
      "key": "textLines",
      "type": "boolean",
      "label": "Lines above and below the text",
      "default": false,
      "group": "Border and lines"
    },
    {
      "key": "lineWidth",
      "type": "number",
      "unit": "mm",
      "label": "Line width",
      "default": 1.5,
      "min": 0.4,
      "max": 6,
      "step": 0.1,
      "group": "Border and lines",
      "showIf": "textLines"
    },
    {
      "key": "lineLength",
      "type": "number",
      "unit": "mm",
      "label": "Line length",
      "default": 60,
      "min": 5,
      "max": 240,
      "step": 1,
      "group": "Border and lines",
      "showIf": "textLines"
    },
    {
      "key": "lineGap",
      "type": "number",
      "unit": "mm",
      "label": "Distance to text",
      "default": 3,
      "min": 0.5,
      "max": 40,
      "step": 0.5,
      "group": "Border and lines",
      "showIf": "textLines"
    },
    {
      "key": "linePattern",
      "type": "select",
      "label": "Line pattern",
      "default": "solid",
      "group": "Border and lines",
      "showIf": "textLines",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ]
    },
    {
      "key": "lineDash",
      "type": "number",
      "unit": "mm",
      "label": "Dash length",
      "default": 3,
      "min": 0.5,
      "max": 20,
      "step": 0.5,
      "group": "Border and lines",
      "showIf": "textLines && linePattern == 'dashed'"
    },
    {
      "key": "lineSpace",
      "type": "number",
      "unit": "mm",
      "label": "Space between dashes",
      "default": 2,
      "min": 0.4,
      "max": 10,
      "step": 0.2,
      "group": "Border and lines",
      "showIf": "textLines && linePattern != 'solid'"
    },
    {
      "key": "lineEnds",
      "type": "select",
      "label": "Line ends",
      "default": "flat",
      "group": "Border and lines",
      "showIf": "textLines && linePattern != 'dotted'",
      "options": [
        {
          "value": "flat",
          "label": "Flat"
        },
        {
          "value": "round",
          "label": "Round"
        }
      ]
    },
    {
      "key": "borderStyle",
      "type": "select",
      "label": "Style",
      "default": "raised",
      "group": "Border and lines",
      "help": "Raised: on top. Flush: inlaid, multi-material. Engraved: cut in.",
      "showIf": "(border || textLines)",
      "options": [
        {
          "value": "raised",
          "label": "Raised"
        },
        {
          "value": "flush",
          "label": "Flush inlay"
        },
        {
          "value": "engraved",
          "label": "Engraved"
        }
      ]
    },
    {
      "key": "borderOwnHeight",
      "type": "boolean",
      "label": "Own height / depth",
      "default": false,
      "group": "Border and lines",
      "help": "Off: same as the text height.",
      "showIf": "(border || textLines)"
    },
    {
      "key": "borderHeight",
      "type": "number",
      "unit": "mm",
      "label": "Height / depth",
      "default": 1,
      "min": 0.2,
      "max": 5,
      "step": 0.1,
      "group": "Border and lines",
      "showIf": "(border || textLines) && borderOwnHeight"
    },
    {
      "key": "borderColor",
      "type": "select",
      "label": "Color",
      "default": "text",
      "group": "Border and lines",
      "help": "Own color: set it under Colors. Needs multi-material.",
      "showIf": "(border || textLines) && borderStyle != 'engraved'",
      "options": [
        {
          "value": "text",
          "label": "Same as text"
        },
        {
          "value": "own",
          "label": "Own color"
        }
      ]
    },
    {
      "key": "holes",
      "type": "boolean",
      "label": "Screw holes",
      "default": false,
      "group": "Mounting"
    },
    {
      "key": "holeDia",
      "type": "number",
      "unit": "mm",
      "label": "Hole diameter",
      "default": 4,
      "min": 2,
      "max": 10,
      "step": 0.5,
      "group": "Mounting",
      "showIf": "holes"
    },
    {
      "key": "edgeTop",
      "type": "select",
      "label": "Top edges",
      "default": "none",
      "group": "Edges",
      "options": [
        {
          "value": "none",
          "label": "Sharp"
        },
        {
          "value": "chamfer",
          "label": "Chamfer"
        },
        {
          "value": "fillet",
          "label": "Fillet"
        }
      ]
    },
    {
      "key": "edgeTopSize",
      "type": "number",
      "unit": "mm",
      "label": "Top edge size",
      "default": 0.8,
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "group": "Edges",
      "showIf": "edgeTop != 'none'"
    },
    {
      "key": "edgeBottom",
      "type": "select",
      "label": "Bottom edges",
      "default": "none",
      "group": "Edges",
      "help": "Printable fillet: 45° chamfer, then a fillet. Prints without supports.",
      "options": [
        {
          "value": "none",
          "label": "Sharp"
        },
        {
          "value": "chamfer",
          "label": "Chamfer"
        },
        {
          "value": "fillet",
          "label": "Fillet"
        },
        {
          "value": "printable",
          "label": "Printable fillet"
        }
      ]
    },
    {
      "key": "edgeBottomSize",
      "type": "number",
      "unit": "mm",
      "label": "Bottom edge size",
      "default": 1,
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "group": "Edges",
      "help": "Chamfer width or fillet radius.",
      "showIf": "edgeBottom != 'none'"
    },
    {
      "key": "edgeBottomChamfer",
      "type": "number",
      "unit": "mm",
      "label": "45° chamfer height",
      "default": 1,
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "group": "Edges",
      "showIf": "edgeBottom == 'printable'"
    }
  ],
  "derived": {
    "outerW": "width - 2 * borderInset",
    "outerH": "height - 2 * borderInset",
    "outerR": "max(corner - borderInset, 0)",
    "holeX": "width / 2 - borderInset - borderWidth - holeDia",
    "borderPart": "borderColor == 'own' ? 'border' : 'accent'",
    "bH": "borderOwnHeight ? borderHeight : raise",
    "borderZ": "borderStyle == 'raised' ? thickness : thickness - bH",
    "borderT": "borderStyle == 'engraved' ? bH + 1 : bH",
    "inner2": "borderWidth + border2Gap",
    "lineY": "textSize / 2 + lineGap + lineWidth / 2"
  },
  "steps": [
    {
      "add": "shape",
      "part": "base",
      "shape": "roundedRect",
      "width": "width",
      "height": "height",
      "radius": "corner",
      "thickness": "thickness"
    },
    {
      "add": "frame",
      "part": "borderPart",
      "when": "border && borderStyle != 'engraved'",
      "comment": "border",
      "shape": "roundedRect",
      "width": "outerW",
      "height": "outerH",
      "radius": "outerR",
      "lineWidth": "borderWidth",
      "z": "borderZ",
      "thickness": "borderT"
    },
    {
      "subtract": "frame",
      "from": "base",
      "when": "border && borderStyle == 'engraved'",
      "comment": "engraved border",
      "shape": "roundedRect",
      "width": "outerW",
      "height": "outerH",
      "radius": "outerR",
      "lineWidth": "borderWidth",
      "z": "borderZ",
      "thickness": "borderT"
    },
    {
      "add": "frame",
      "part": "borderPart",
      "when": "border && border2 && borderStyle != 'engraved'",
      "comment": "second border line",
      "shape": "roundedRect",
      "width": "outerW - 2 * inner2",
      "height": "outerH - 2 * inner2",
      "radius": "max(outerR - inner2, 0)",
      "lineWidth": "border2Width",
      "z": "borderZ",
      "thickness": "borderT"
    },
    {
      "subtract": "frame",
      "from": "base",
      "when": "border && border2 && borderStyle == 'engraved'",
      "comment": "engraved second border line",
      "shape": "roundedRect",
      "width": "outerW - 2 * inner2",
      "height": "outerH - 2 * inner2",
      "radius": "max(outerR - inner2, 0)",
      "lineWidth": "border2Width",
      "z": "borderZ",
      "thickness": "borderT"
    },
    {
      "add": "line",
      "part": "borderPart",
      "when": "textLines && borderStyle != 'engraved'",
      "comment": "line above the text",
      "length": "lineLength",
      "lineWidth": "lineWidth",
      "pattern": "linePattern",
      "dash": "lineDash",
      "gap": "lineSpace",
      "ends": "lineEnds",
      "y": "lineY",
      "z": "borderZ",
      "thickness": "borderT"
    },
    {
      "subtract": "line",
      "from": "base",
      "when": "textLines && borderStyle == 'engraved'",
      "comment": "engraved line above the text",
      "length": "lineLength",
      "lineWidth": "lineWidth",
      "pattern": "linePattern",
      "dash": "lineDash",
      "gap": "lineSpace",
      "ends": "lineEnds",
      "y": "lineY",
      "z": "borderZ",
      "thickness": "borderT"
    },
    {
      "add": "line",
      "part": "borderPart",
      "when": "textLines && borderStyle != 'engraved'",
      "comment": "line below the text",
      "length": "lineLength",
      "lineWidth": "lineWidth",
      "pattern": "linePattern",
      "dash": "lineDash",
      "gap": "lineSpace",
      "ends": "lineEnds",
      "y": "-lineY",
      "z": "borderZ",
      "thickness": "borderT"
    },
    {
      "subtract": "line",
      "from": "base",
      "when": "textLines && borderStyle == 'engraved'",
      "comment": "engraved line below the text",
      "length": "lineLength",
      "lineWidth": "lineWidth",
      "pattern": "linePattern",
      "dash": "lineDash",
      "gap": "lineSpace",
      "ends": "lineEnds",
      "y": "-lineY",
      "z": "borderZ",
      "thickness": "borderT"
    },
    {
      "add": "text",
      "part": "accent",
      "text": "text",
      "size": "textSize",
      "font": "font",
      "z": "thickness",
      "thickness": "raise"
    },
    {
      "subtract": "shape",
      "when": "holes",
      "shape": "circle",
      "diameter": "holeDia",
      "x": "-holeX",
      "through": true
    },
    {
      "subtract": "shape",
      "when": "holes",
      "shape": "circle",
      "diameter": "holeDia",
      "x": "holeX",
      "through": true
    }
  ],
  "notes": [
    {
      "when": "holes",
      "text": "Wide text runs into the screw holes. Shorten it or widen the sign."
    },
    {
      "when": "(border || textLines) && borderStyle != 'raised' && bH > thickness - 0.6",
      "text": "Border and lines are almost as deep as the plate. Make them shallower."
    },
    {
      "when": "(border || textLines) && borderStyle == 'flush'",
      "text": "A flush border needs the multi-material 3MF."
    },
    {
      "when": "(border || textLines) && borderColor == 'own' && borderStyle == 'raised'",
      "text": "Border and lines in their own color need the multi-material 3MF."
    }
  ]
}
